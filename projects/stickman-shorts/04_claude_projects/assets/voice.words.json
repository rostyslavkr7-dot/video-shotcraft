[{"start": 0.0, "end": 5.84, "text": " Он загрузил в ней рассеть методичку, письмо науч рука и свой старый код, и ни о чем ее не спросил.", "words": [{"w": " Он", "s": 0.0, "e": 0.12}, {"w": " загрузил", "s": 0.12, "e": 0.56}, {"w": " в", "s": 0.56, "e": 0.66}, {"w": " ней", "s": 0.66, "e": 0.74}, {"w": " рассеть", "s": 0.74, "e": 1.08}, {"w": " методичку,", "s": 1.08, "e": 1.74}, {"w": " письмо", "s": 1.94, "e": 2.22}, {"w": " науч", "s": 2.22, "e": 2.46}, {"w": " рука", "s": 2.46, "e": 2.84}, {"w": " и", "s": 2.84, "e": 3.04}, {"w": " свой", "s": 3.04, "e": 3.26}, {"w": " старый", "s": 3.26, "e": 3.64}, {"w": " код,", "s": 3.64, "e": 3.94}, {"w": " и", "s": 4.32, "e": 4.4}, {"w": " ни", "s": 4.4, "e": 4.6}, {"w": " о", "s": 4.6, "e": 4.76}, {"w": " чем", "s": 4.76, "e": 4.96}, {"w": " ее", "s": 4.96, "e": 5.22}, {"w": " не", "s": 5.22, "e": 5.36}, {"w": " спросил.", "s": 5.36, "e": 5.84}]}, {"start": 6.12, "end": 7.5, "text": " Просто закрыл ноутбук.", "words": [{"w": " Просто", "s": 6.12, "e": 6.48}, {"w": " закрыл", "s": 6.48, "e": 7.08}, {"w": " ноутбук.", "s": 7.08, "e": 7.5}]}, {"start": 7.98, "end": 9.3, "text": " До защиты — неделя.", "words": [{"w": " До", "s": 7.98, "e": 8.1}, {"w": " защиты", "s": 8.1, "e": 8.54}, {"w": " —", "s": 8.54, "e": 8.88}, {"w": " неделя.", "s": 8.88, "e": 9.3}]}, {"start": 9.74, "end": 12.7, "text": " Каждый день он открывает новый чат и пишет одну строчку.", "words": [{"w": " Каждый", "s": 9.74, "e": 10.04}, {"w": " день", "s": 10.04, "e": 10.28}, {"w": " он", "s": 10.28, "e": 10.46}, {"w": " открывает", "s": 10.46, "e": 10.88}, {"w": " новый", "s": 10.88, "e": 11.1}, {"w": " чат", "s": 11.1, "e": 11.4}, {"w": " и", "s": 11.4, "e": 11.64}, {"w": " пишет", "s": 11.64, "e": 11.98}, {"w": " одну", "s": 11.98, "e": 12.26}, {"w": " строчку.", "s": 12.26, "e": 12.7}]}, {"start": 13.16, "end": 14.56, "text": " Продолжай третью главу.", "words": [{"w": " Продолжай", "s": 13.16, "e": 13.72}, {"w": " третью", "s": 13.72, "e": 14.16}, {"w": " главу.", "s": 14.16, "e": 14.56}]}, {"start": 14.94, "end": 16.42, "text": " Сосед заглядывает через плечо.", "words": [{"w": " Сосед", "s": 14.94, "e": 15.24}, {"w": " заглядывает", "s": 15.24, "e": 15.76}, {"w": " через", "s": 15.76, "e": 15.96}, {"w": " плечо.", "s": 15.96, "e": 16.42}]}, {"start": 16.76, "end": 18.78, "text": " Вы с ней что, телепатии общаетесь?", "words": [{"w": " Вы", "s": 16.76, "e": 16.96}, {"w": " с", "s": 16.96, "e": 17.08}, {"w": " ней", "s": 17.08, "e": 17.16}, {"w": " что,", "s": 17.16, "e": 17.38}, {"w": " телепатии", "s": 17.62, "e": 18.16}, {"w": " общаетесь?", "s": 18.16, "e": 18.78}]}, {"start": 19.12, "end": 21.98, "text": " Сам сосед каждое утро вставляет в чат одно и то же.", "words": [{"w": " Сам", "s": 19.12, "e": 19.4}, {"w": " сосед", "s": 19.4, "e": 19.76}, {"w": " каждое", "s": 19.76, "e": 20.18}, {"w": " утро", "s": 20.18, "e": 20.52}, {"w": " вставляет", "s": 20.52, "e": 20.96}, {"w": " в", "s": 20.96, "e": 21.04}, {"w": " чат", "s": 21.04, "e": 21.22}, {"w": " одно", "s": 21.22, "e": 21.56}, {"w": " и", "s": 21.56, "e": 21.68}, {"w": " то", "s": 21.68, "e": 21.82}, {"w": " же.", "s": 21.82, "e": 21.98}]}, {"start": 22.3, "end": 24.64, "text": " Кто он, какая тема, какие требования.", "words": [{"w": " Кто", "s": 22.3, "e": 22.54}, {"w": " он,", "s": 22.54, "e": 22.78}, {"w": " какая", "s": 22.96, "e": 23.12}, {"w": " тема,", "s": 23.12, "e": 23.68}, {"w": " какие", "s": 23.84, "e": 24.04}, {"w": " требования.", "s": 24.04, "e": 24.64}]}, {"start": 24.98, "end": 26.44, "text": " Пиши строго без воды.", "words": [{"w": " Пиши", "s": 24.98, "e": 25.32}, {"w": " строго", "s": 25.32, "e": 25.74}, {"w": " без", "s": 25.74, "e": 26.14}, {"w": " воды.", "s": 26.14, "e": 26.44}]}, {"start": 26.88, "end": 27.58, "text": " Три страницы.", "words": [{"w": " Три", "s": 26.88, "e": 27.04}, {"w": " страницы.", "s": 27.04, "e": 27.58}]}, {"start": 27.58, "end": 28.44, "text": " Каждый.", "words": [{"w": " Каждый.", "s": 27.58, "e": 28.44}]}, {"start": 28.64, "end": 28.96, "text": " Раз.", "words": [{"w": " Раз.", "s": 28.64, "e": 28.96}]}, {"start": 29.5, "end": 31.66, "text": " К пятнице он скопировал их 40 раз.", "words": [{"w": " К", "s": 29.5, "e": 29.58}, {"w": " пятнице", "s": 29.58, "e": 30.04}, {"w": " он", "s": 30.04, "e": 30.28}, {"w": " скопировал", "s": 30.28, "e": 30.82}, {"w": " их", "s": 30.82, "e": 31.02}, {"w": " 40", "s": 31.02, "e": 31.36}, {"w": " раз.", "s": 31.36, "e": 31.66}]}, {"start": 31.96, "end": 34.3, "text": " А на 41-й забыл последний абзац.", "words": [{"w": " А", "s": 31.96, "e": 32.12}, {"w": " на", "s": 32.12, "e": 32.2}, {"w": " 41", "s": 32.2, "e": 32.4}, {"w": "-й", "s": 32.4, "e": 32.88}, {"w": " забыл", "s": 32.88, "e": 33.42}, {"w": " последний", "s": 33.42, "e": 33.88}, {"w": " абзац.", "s": 33.88, "e": 34.3}]}, {"start": 34.7, "end": 38.38, "text": " И клод бодро написал ему главу диплома в стиле поста для соцсетей.", "words": [{"w": " И", "s": 34.7, "e": 34.8}, {"w": " клод", "s": 34.8, "e": 35.08}, {"w": " бодро", "s": 35.08, "e": 35.52}, {"w": " написал", "s": 35.52, "e": 35.92}, {"w": " ему", "s": 35.92, "e": 36.08}, {"w": " главу", "s": 36.08, "e": 36.4}, {"w": " диплома", "s": 36.4, "e": 36.84}, {"w": " в", "s": 36.84, "e": 37.0}, {"w": " стиле", "s": 37.0, "e": 37.26}, {"w": " поста", "s": 37.26, "e": 37.58}, {"w": " для", "s": 37.58, "e": 37.74}, {"w": " соцсетей.", "s": 37.74, "e": 38.38}]}, {"start": 38.62, "end": 39.08, "text": " С эмоций.", "words": [{"w": " С", "s": 38.62, "e": 38.76}, {"w": " эмоций.", "s": 38.76, "e": 39.08}]}, {"start": 39.52, "end": 41.66, "text": " Видишь ли, у клода есть проекты.", "words": [{"w": " Видишь", "s": 39.52, "e": 39.84}, {"w": " ли,", "s": 39.84, "e": 40.02}, {"w": " у", "s": 40.24, "e": 40.32}, {"w": " клода", "s": 40.32, "e": 40.62}, {"w": " есть", "s": 40.62, "e": 40.92}, {"w": " проекты.", "s": 40.92, "e": 41.66}]}, {"start": 41.98, "end": 44.98, "text": " Это папка, которая лежит перед ним в каждом чате проекта.", "words": [{"w": " Это", "s": 41.98, "e": 42.18}, {"w": " папка,", "s": 42.18, "e": 42.6}, {"w": " которая", "s": 42.64, "e": 42.94}, {"w": " лежит", "s": 42.94, "e": 43.28}, {"w": " перед", "s": 43.28, "e": 43.46}, {"w": " ним", "s": 43.46, "e": 43.66}, {"w": " в", "s": 43.66, "e": 43.82}, {"w": " каждом", "s": 43.82, "e": 44.14}, {"w": " чате", "s": 44.14, "e": 44.42}, {"w": " проекта.", "s": 44.42, "e": 44.98}]}, {"start": 45.22, "end": 46.68, "text": " Твои файлы и инструкция.", "words": [{"w": " Твои", "s": 45.22, "e": 45.5}, {"w": " файлы", "s": 45.5, "e": 45.88}, {"w": " и", "s": 45.88, "e": 46.14}, {"w": " инструкция.", "s": 46.14, "e": 46.68}]}, {"start": 46.96, "end": 48.5, "text": " Кто ты и как тебе отвечать?", "words": [{"w": " Кто", "s": 46.96, "e": 47.18}, {"w": " ты", "s": 47.18, "e": 47.36}, {"w": " и", "s": 47.36, "e": 47.58}, {"w": " как", "s": 47.58, "e": 47.78}, {"w": " тебе", "s": 47.78, "e": 48.02}, {"w": " отвечать?", "s": 48.02, "e": 48.5}]}, {"start": 48.82, "end": 51.0, "text": " Положил один раз и больше не объясняешь.", "words": [{"w": " Положил", "s": 48.82, "e": 49.22}, {"w": " один", "s": 49.22, "e": 49.4}, {"w": " раз", "s": 49.4, "e": 49.64}, {"w": " и", "s": 49.64, "e": 49.9}, {"w": " больше", "s": 49.9, "e": 50.22}, {"w": " не", "s": 50.22, "e": 50.42}, {"w": " объясняешь.", "s": 50.42, "e": 51.0}]}, {"start": 51.26, "end": 54.34, "text": " Как официант, который запомнил, что ты всегда берешь без лука.", "words": [{"w": " Как", "s": 51.26, "e": 51.44}, {"w": " официант,", "s": 51.44, "e": 51.92}, {"w": " который", "s": 51.98, "e": 52.18}, {"w": " запомнил,", "s": 52.18, "e": 52.74}, {"w": " что", "s": 52.8, "e": 52.92}, {"w": " ты", "s": 52.92, "e": 53.1}, {"w": " всегда", "s": 53.1, "e": 53.52}, {"w": " берешь", "s": 53.52, "e": 53.86}, {"w": " без", "s": 53.86, "e": 54.04}, {"w": " лука.", "s": 54.04, "e": 54.34}]}, {"start": 54.62, "end": 56.34, "text": " Они спрашивают об этом каждый вечер.", "words": [{"w": " Они", "s": 54.62, "e": 54.78}, {"w": " спрашивают", "s": 54.78, "e": 55.32}, {"w": " об", "s": 55.32, "e": 55.46}, {"w": " этом", "s": 55.46, "e": 55.6}, {"w": " каждый", "s": 55.6, "e": 55.88}, {"w": " вечер.", "s": 55.88, "e": 56.34}]}, {"start": 56.34, "end": 60.24, "text": " Так что в пятницу один из них отправляет на учруку третью главу.", "words": [{"w": " Так", "s": 56.34, "e": 56.78}, {"w": " что", "s": 56.78, "e": 56.96}, {"w": " в", "s": 56.96, "e": 57.06}, {"w": " пятницу", "s": 57.06, "e": 57.52}, {"w": " один", "s": 57.52, "e": 57.86}, {"w": " из", "s": 57.86, "e": 58.06}, {"w": " них", "s": 58.06, "e": 58.22}, {"w": " отправляет", "s": 58.22, "e": 58.82}, {"w": " на", "s": 58.82, "e": 58.92}, {"w": " учруку", "s": 58.92, "e": 59.3}, {"w": " третью", "s": 59.3, "e": 59.72}, {"w": " главу.", "s": 59.72, "e": 60.24}]}, {"start": 60.34, "end": 63.46, "text": " А второй объясняет, почему его диплом начинается со слов.", "words": [{"w": " А", "s": 60.34, "e": 60.46}, {"w": " второй", "s": 60.46, "e": 60.74}, {"w": " объясняет,", "s": 60.74, "e": 61.54}, {"w": " почему", "s": 61.64, "e": 61.94}, {"w": " его", "s": 61.94, "e": 62.2}, {"w": " диплом", "s": 62.2, "e": 62.54}, {"w": " начинается", "s": 62.54, "e": 63.08}, {"w": " со", "s": 63.08, "e": 63.24}, {"w": " слов.", "s": 63.24, "e": 63.46}]}, {"start": 63.86, "end": 64.62, "text": " Всем привет, друзья!", "words": [{"w": " Всем", "s": 63.86, "e": 64.04}, {"w": " привет,", "s": 64.04, "e": 64.36}, {"w": " друзья!", "s": 64.5, "e": 64.62}]}]